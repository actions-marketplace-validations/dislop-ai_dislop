{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-10-17/server.schema.json",
  "name": "io.github.dislop-ai/dislop",
  "description": "Cross-modal anti-AI-slop quality gate and pluggable Taste Packs for prose, HTML, PDF, and office docs.",
  "version": "0.1.0",
  "websiteUrl": "https://dislop.com",
  "repository": {
    "url": "https://github.com/dislop-ai/dislop",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "dislop",
      "version": "0.1.0",
      "runtimeHint": "npx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "--mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    },
    {
      "registryType": "pypi",
      "identifier": "dislop",
      "version": "0.1.0",
      "runtimeHint": "uvx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "--mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
