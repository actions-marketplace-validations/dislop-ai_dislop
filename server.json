{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-10-17/server.schema.json",
  "name": "io.github.dislop-ai/dislop",
  "description": "Deterministic pre-publication linter and revision verifier for Markdown, HTML/CSS/SVG, DOCX, PPTX, and PDF metadata.",
  "version": "0.2.0",
  "websiteUrl": "https://dislop.com",
  "repository": {
    "url": "https://github.com/dislop-ai/dislop",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "dislop",
      "version": "0.2.0",
      "runtimeHint": "npx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "--mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    },
    {
      "registryType": "pypi",
      "identifier": "dislop",
      "version": "0.2.0",
      "runtimeHint": "uvx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "--mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
