{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.dislop-ai/dislop",
  "title": "dislop",
  "description": "Zero-dependency anti-slop linter & Cloud MCP for AI-written docs, slides, and web UI.",
  "version": "0.6.2",
  "websiteUrl": "https://dislop.com",
  "repository": {
    "url": "https://github.com/dislop-ai/dislop",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "dislop",
      "version": "0.6.2",
      "runtimeHint": "npx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "--mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    },
    {
      "registryType": "pypi",
      "identifier": "dislop",
      "version": "0.6.2",
      "runtimeHint": "uvx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "--mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://dislop.com/mcp"
    }
  ]
}
