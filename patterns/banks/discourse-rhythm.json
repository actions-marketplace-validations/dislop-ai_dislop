{
  "schema": "dislop.pattern-bank/1",
  "id": "discourse-rhythm",
  "version": "1.0.0",
  "description": {
    "en": "Declarative signal lists and calibrated thresholds for rhythm, cadence, formatting density, and mechanical discourse signposting.",
    "zh": "节奏、韵律、排版密度与机械过渡路标簇的声明式信号词库与校准阈值。"
  },
  "commaChain": {
    "ruleId": "comma-chain-runon",
    "dimension": "rhythm",
    "detectionAngle": "rhythm-statistics",
    "severity": "info",
    "minCommas": 5,
    "minLongClauses": 4,
    "zh": { "minClauseUnits": 4, "minAvgClauseUnits": 5.0 },
    "en": { "minClauseUnits": 3, "minAvgClauseUnits": 3.2 },
    "maxMarkdownLinks": 2
  },
  "sentenceLengthMonotony": {
    "ruleId": "low-burstiness-vapor",
    "dimension": "rhythm",
    "detectionAngle": "rhythm-statistics",
    "severity": "info",
    "minSentences": 5,
    "minSentenceUnits": 4,
    "maxCv": 0.16,
    "minMeanUnitsZh": 14,
    "minMeanUnitsEn": 10
  },
  "openerAnaphora": {
    "ruleId": "opener-anaphora-monotony",
    "dimension": "rhythm",
    "detectionAngle": "rhythm-statistics",
    "severity": "info",
    "minConsecutive": 4,
    "minOpenerCharsZh": 2,
    "minOpenerWordsEn": 2
  },
  "inlineBoldSaturation": {
    "ruleId": "inline-bold-saturation",
    "dimension": "rhythm",
    "detectionAngle": "rhythm-statistics",
    "severity": "info",
    "minBoldSpans": 4,
    "maxWordsPerBoldEn": 28,
    "maxCjkPerBoldZh": 55
  },
  "paragraphLengthUniformity": {
    "ruleId": "paragraph-length-uniformity",
    "dimension": "rhythm",
    "detectionAngle": "rhythm-statistics",
    "severity": "info",
    "minParagraphs": 5,
    "minMeanUnits": 35,
    "maxCv": 0.13
  },
  "discourseMarkers": {
    "ruleId": "discourse-marker-cluster",
    "dimension": "discourse",
    "detectionAngle": "discourse-structure",
    "severity": "warning",
    "minConsecutiveParagraphs": 3,
    "minMarkersInParagraph": 3,
    "zhLeadMarkers": [
      "首先",
      "其次",
      "再次",
      "此外",
      "另外",
      "与此同时",
      "不仅如此",
      "进一步来说",
      "进一步来看",
      "最后",
      "总而言之",
      "综上所述",
      "归根结底"
    ],
    "enLeadMarkers": [
      "Firstly",
      "Secondly",
      "Thirdly",
      "Furthermore",
      "Moreover",
      "Additionally",
      "In addition",
      "Consequently",
      "Ultimately",
      "In conclusion",
      "To summarize",
      "Notably"
    ]
  }
}
