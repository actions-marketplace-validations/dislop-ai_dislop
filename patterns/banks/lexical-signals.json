{
  "schema": "dislop.pattern-bank/1",
  "id": "lexical-signals",
  "version": "1.0.0",
  "description": {
    "en": "Weighted, evidence-graded bilingual lexical, collocation, and Chinese translation-calque signal banks. Triggers only on paragraph-level clusters to avoid single-word false positives.",
    "zh": "带权重与证据分级的双语高频 AI 词汇、词组搭配与中文翻译腔信号库；仅按段落簇密度触发，避免单词误报。"
  },
  "zhCalqueCluster": {
    "ruleId": "zh-ai-calque-cluster",
    "dimension": "lexical",
    "detectionAngle": "lexicon-cluster",
    "severity": "info",
    "minDistinctHits": 2,
    "minWeightedScore": 2.2,
    "signals": [
      { "id": "zh-bg-context", "pattern": "在[^，。！？\\n]{2,18}的背景下", "weight": 1.2 },
      { "id": "zh-undeniable", "pattern": "不可否认(?:的是)?", "weight": 1.3 },
      { "id": "zh-no-exaggeration", "pattern": "毫不夸张地说", "weight": 1.4 },
      { "id": "zh-in-a-sense", "pattern": "从某种意义上(?:来)?说", "weight": 1.3 },
      { "id": "zh-in-other-words", "pattern": "换句话说", "weight": 1.0 },
      { "id": "zh-huan-yan-zhi", "pattern": "换言之", "weight": 1.1 },
      { "id": "zh-not-only-that", "pattern": "不仅如此", "weight": 1.0 },
      { "id": "zh-plays-role", "pattern": "扮演着[^，。！？\\n]{0,10}角色", "weight": 1.4 },
      { "id": "zh-double-edged", "pattern": "是一把双刃剑", "weight": 1.4 },
      { "id": "zh-strong-support", "pattern": "提供(?:了)?有力支撑", "weight": 1.3 },
      { "id": "zh-crucial", "pattern": "至关重要", "weight": 1.0 },
      { "id": "zh-unprecedented", "pattern": "前所未有", "weight": 1.1 },
      { "id": "zh-quietly-change", "pattern": "(?:深刻|悄然)改变", "weight": 1.2 },
      { "id": "zh-especially-key", "pattern": "尤为关键", "weight": 1.1 },
      { "id": "zh-self-evident", "pattern": "不言而喻", "weight": 1.2 },
      { "id": "zh-obvious", "pattern": "显而易见", "weight": 1.1 },
      { "id": "zh-cannot-ignore", "pattern": "不容忽视", "weight": 1.1 },
      { "id": "zh-undoubtedly", "pattern": "毋庸置疑", "weight": 1.2 },
      { "id": "zh-wide-attention", "pattern": "引发了广泛关注", "weight": 1.3 },
      { "id": "zh-worth-pondering", "pattern": "值得深思的是", "weight": 1.3 },
      { "id": "zh-long-run", "pattern": "从长远来看", "weight": 1.0 }
    ]
  },
  "enPhraseCluster": {
    "ruleId": "en-ai-phrase-cluster",
    "dimension": "lexical",
    "detectionAngle": "lexicon-cluster",
    "severity": "info",
    "minDistinctHits": 3,
    "minWeightedScore": 3.2,
    "signals": [
      { "id": "en-meticulous", "pattern": "\\bmeticulous(?:ly)?\\b", "weight": 1.2 },
      { "id": "en-intricate", "pattern": "\\bintricate\\b", "weight": 1.2 },
      { "id": "en-pivotal", "pattern": "\\bpivotal\\b", "weight": 1.3 },
      { "id": "en-foster", "pattern": "\\bfoster(?:s|ed|ing)?\\b", "weight": 1.1 },
      { "id": "en-underscore", "pattern": "\\bunderscore(?:s|d|ing)?\\b", "weight": 1.2 },
      { "id": "en-nuanced", "pattern": "\\bnuanced\\b", "weight": 1.2 },
      { "id": "en-seamless", "pattern": "\\bseamless(?:ly)?\\b", "weight": 1.2 },
      { "id": "en-holistic", "pattern": "\\bholistic\\b", "weight": 1.3 },
      { "id": "en-groundbreaking", "pattern": "\\bgroundbreaking\\b", "weight": 1.3 },
      { "id": "en-ever-evolving", "pattern": "\\bever-evolving\\b", "weight": 1.4 },
      { "id": "en-realm-of", "pattern": "\\brealm of\\b", "weight": 1.3 },
      { "id": "en-landscape-of", "pattern": "\\blandscape of\\b", "weight": 1.2 },
      { "id": "en-navigate-complexities", "pattern": "\\bnavigate the complexities\\b", "weight": 1.5 },
      { "id": "en-crucial-role", "pattern": "\\bcrucial role\\b", "weight": 1.2 },
      { "id": "en-serves-as-a", "pattern": "\\bserve(?:s)? as a\\b", "weight": 1.0 },
      { "id": "en-boasts-a", "pattern": "\\bboasts a\\b", "weight": 1.3 },
      { "id": "en-tapestry", "pattern": "\\btapestry\\b", "weight": 1.2 },
      { "id": "en-leverage", "pattern": "\\bleverage(?:s|d|ing)?\\b", "weight": 1.0 },
      { "id": "en-comprehensive", "pattern": "\\bcomprehensive\\b", "weight": 0.9 },
      { "id": "en-robust", "pattern": "\\brobust\\b", "weight": 0.9 },
      { "id": "en-transformative", "pattern": "\\btransformative\\b", "weight": 1.2 },
      { "id": "en-paramount", "pattern": "\\bparamount\\b", "weight": 1.2 },
      { "id": "en-multifaceted", "pattern": "\\bmultifaceted\\b", "weight": 1.3 },
      { "id": "en-streamline", "pattern": "\\bstreamline(?:s|d|ing)?\\b", "weight": 1.0 }
    ]
  }
}
