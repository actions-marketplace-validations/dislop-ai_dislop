{
  "name": "dislop",
  "version": "0.2.0",
  "description": "Multi-modal de-slop toolkit and fact-preserving revision verifier for writing, Markdown, HTML/CSS/JSX/SVG, DOCX, PPTX, and PDF (Web, Skill, CLI & MCP)",
  "license": "Apache-2.0",
  "homepage": "https://dislop.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dislop-ai/dislop.git"
  },
  "bugs": {
    "url": "https://github.com/dislop-ai/dislop/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": "./src/core.mjs",
    "./core": "./src/core.mjs"
  },
  "bin": {
    "dislop": "./bin/dislop.mjs",
    "dislop-mcp": "./bin/dislop-mcp.mjs"
  },
  "scripts": {
    "test": "node bin/dislop.mjs pack-test && node tests/test_site.mjs",
    "build:site": "node scripts/build_site.mjs",
    "test:prototype": "node scripts/prototype_antipattern_lab.mjs self-test",
    "dogfood": "node bin/dislop.mjs check . --fail-on warning && node bin/dislop.mjs check site/ --fail-on info"
  },
  "files": [
    "bin/",
    "src/core.mjs",
    "src/binary-node.mjs",
    "packs/",
    "skills/",
    "assets/",
    "docs/architecture.md",
    "docs/architecture.zh-CN.md",
    "docs/design-system.md",
    "docs/design-system.zh-CN.md",
    "docs/strategy-and-roadmap.md",
    "docs/strategy-and-roadmap.zh-CN.md",
    "CHANGELOG.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "keywords": [
    "anti-slop",
    "de-slop",
    "ai-slop",
    "linter",
    "proofreading",
    "agent-skill",
    "llms-txt",
    "mcp",
    "model-context-protocol",
    "editorial",
    "typography",
    "quality-gate"
  ],
  "mcpName": "io.github.dislop-ai/dislop"
}
