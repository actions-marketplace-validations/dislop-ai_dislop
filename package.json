{
  "name": "dislop",
  "version": "0.3.0",
  "description": "Local zero-dependency anti-slop linter for AI-written docs, Word/PowerPoint files, and web pages.",
  "license": "Apache-2.0",
  "homepage": "https://dislop.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dislop-ai/dislop.git"
  },
  "bugs": {
    "url": "https://github.com/dislop-ai/dislop/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": "./src/core.mjs",
    "./core": "./src/core.mjs"
  },
  "bin": {
    "dislop": "./bin/dislop.mjs",
    "dislop-mcp": "./bin/dislop-mcp.mjs"
  },
  "scripts": {
    "test": "node bin/dislop.mjs pack-test && node tests/test_site.mjs && node tests/test_server.mjs",
    "test:server": "node tests/test_server.mjs",
    "bench": "node scripts/run_benchmark.mjs",
    "bench:assert": "node scripts/run_benchmark.mjs --assert",
    "server": "node server/index.mjs",
    "build:site": "node scripts/build_site.mjs",
    "test:prototype": "node scripts/prototype_antipattern_lab.mjs self-test",
    "dogfood": "node bin/dislop.mjs check . --fail-on warning && node bin/dislop.mjs check site/ --fail-on info"
  },
  "files": [
    ".claude-plugin/",
    ".mcp.json",
    "bin/",
    "src/core.mjs",
    "src/binary-node.mjs",
    "server/index.mjs",
    "server/llm-client.mjs",
    "server/probes.mjs",
    "server/.env.example",
    "server/Dockerfile",
    "server/README.md",
    "server/README.zh-CN.md",
    "packs/",
    "skills/",
    "assets/",
    "docs/architecture.md",
    "docs/architecture.zh-CN.md",
    "docs/design-system.md",
    "docs/design-system.zh-CN.md",
    "docs/brand-and-voice-guide.md",
    "docs/brand-and-voice-guide.zh-CN.md",
    "docs/brand/voice.json",
    "awesome/README.md",
    "awesome/README.zh-CN.md",
    "CHANGELOG.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "keywords": [
    "anti-slop",
    "de-slop",
    "ai-slop",
    "linter",
    "proofreading",
    "agent-skill",
    "llms-txt",
    "mcp",
    "model-context-protocol",
    "editorial",
    "typography",
    "quality-gate"
  ],
  "mcpName": "io.github.dislop-ai/dislop"
}
