# Copy to .env on your server (NEVER commit .env or any real API key)
DISLOP_HOST=127.0.0.1
DISLOP_PORT=8787

# Optional: OpenAI-compatible LLM endpoint (Google Gemini Paid/Vertex AI, OpenAI, DeepSeek, OpenRouter, Ollama)
# Privacy note: For public or commercial deployments, use a Paid/Vertex AI tier whose terms do NOT train on user prompts.
# Leave DISLOP_LLM_API_KEY empty to run deterministic-only HTTP/MCP endpoints.
DISLOP_LLM_API_KEY=
DISLOP_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
DISLOP_LLM_MODEL=gemini-3.5-flash
# Optional tiered routing (cheaper fast model for review, stronger model for deslop):
DISLOP_LLM_MODEL_REVIEW=gemini-3.5-flash-lite
DISLOP_LLM_MODEL_DESLOP=gemini-3.5-flash
DISLOP_LLM_TIMEOUT_MS=30000

# Security, rate limits & hard daily credit budget (0 = unlimited for private self-hosting)
DISLOP_MAX_BODY_BYTES=65536
DISLOP_RATE_LIMIT_PER_MIN=30
DISLOP_DAILY_LLM_LIMIT=500
DISLOP_CORS_ORIGIN=https://dislop.com
# Optional bearer token for private/team self-hosted deployments:
DISLOP_SERVER_AUTH_TOKEN=
