    },
    {
      "id": "ho-13-html-disabled-explained-clean",
      "domain": "html-ui",
      "pack": "deck-and-ui",
      "modality": "html",
      "filename": "export.html",
      "expected": "clean",
      "category": "near-miss",
      "expectedRuleIds": [],
      "text": "<button type=\"button\" disabled title=\"Disabled until a CSV is uploaded\">Export CSV</button>"
    },
    {
      "id": "ho-14-html-real-anchor-clean",
      "domain": "html-ui",
      "pack": "deck-and-ui",
      "modality": "html",
      "filename": "nav.html",
      "expected": "clean",
      "category": "near-miss",
      "expectedRuleIds": [],
      "text": "<a href=\"#pricing\">See pricing</a>"
    },
    {
      "id": "ho-15-zh-clean-metrics",
      "domain": "zh-brief",
      "pack": "business-brief",
      "modality": "markdown",
      "filename": "q4.md",
      "expected": "clean",
      "category": "clean",
      "expectedRuleIds": [],
      "text": "Q4 结算引擎采用全链路异步化架构，峰值 TPS 从 1,200 提升至 4,800，P99 延迟从 210ms 降至 42ms，数据一致性达 99.99%。"
    },
    {
      "id": "ho-16-en-single-emdash-clean",
      "domain": "en-essay",
      "pack": "literary-essay",
      "modality": "markdown",
      "filename": "crane.md",
      "expected": "clean",
      "category": "clean",
      "expectedRuleIds": [],
      "text": "At 05:40 the crane stopped—two bolts had sheared on the south rail—and the crew waited for the replacement kit from Rotterdam."
    }
  ]
